{
  "name": "powerb2x-demo-hydrogen",
  "private": true,
  "sideEffects": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen",
    "preview": "npm run build && shopify hydrogen preview",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --no-error-on-unmatched-pattern --ext .js,.ts,.jsx,.tsx .",
    "verify": "./scripts/verify.sh",
    "format": "prettier --write --ignore-unknown .",
    "codegen": "shopify hydrogen codegen",
    "format:check": "prettier --check --ignore-unknown .",
    "prepare": "husky",
    "check:design": "node scripts/check-design-tokens.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:b2b": "node scripts/setup-b2b.mjs"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@headlessui/react": "^2.1.3",
    "@remix-run/react": "^2.10.1",
    "@remix-run/server-runtime": "^2.10.1",
    "@shopify/admin-api-client": "^1.0.0",
    "@shopify/cli-hydrogen": "^8.0.4",
    "@shopify/hydrogen": "^2024.7.4",
    "@shopify/remix-oxygen": "^2.0.6",
    "clsx": "^2.1.1",
    "graphql": "^16.6.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^3.8.0",
    "js-cookie": "^3.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-use": "^17.5.0",
    "tiny-variant": "^0.0.0",
    "typographic-base": "^1.0.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.2",
    "@remix-run/dev": "^2.10.1",
    "@remix-run/eslint-config": "^2.10.1",
    "@shopify/cli": "^3.65.3",
    "@shopify/hydrogen-codegen": "^0.3.1",
    "@shopify/mini-oxygen": "^3.0.4",
    "@shopify/oxygen-workers-types": "^4.1.2",
    "@shopify/prettier-config": "^1.1.2",
    "@total-typescript/ts-reset": "^0.4.2",
    "@types/eslint": "^8.4.10",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.2.7",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.20.0",
    "eslint-plugin-hydrogen": "0.12.2",
    "husky": "^9.1.2",
    "postcss": "^8.4.38",
    "prettier": "^2.8.4",
