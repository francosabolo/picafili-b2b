    "tailwindcss": "^3.4.3",
    "tiny-invariant": "^1.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^4.3.1"
