# Copiá este archivo a `.env` y completá los valores de TU tienda.
# `.env` está en .gitignore: no lo commitees.
#
# Los valores de Shopify salen del admin de la tienda (Headless / Hydrogen
# channel) o de `npx shopify hydrogen env pull` si el storefront ya existe.

# --- Tienda -----------------------------------------------------------------
PUBLIC_STORE_DOMAIN=tu-tienda.myshopify.com
PUBLIC_STOREFRONT_ID=
SHOP_ID=
PUBLIC_CHECKOUT_DOMAIN=

# --- Storefront API ---------------------------------------------------------
PUBLIC_STOREFRONT_API_TOKEN=
PRIVATE_STOREFRONT_API_TOKEN=

# --- Customer Account API ---------------------------------------------------
# Ojo: /account/* no funciona contra localhost. Necesita un dominio público
# (túnel) declarado en la app de Customer Accounts de Shopify.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=

# --- Admin API --------------------------------------------------------------
# Crea los draft orders del presupuesto. NUNCA sale del servidor.
#
# ⚠️ Hace falta aunque no vayas a tocar cotizaciones: el cliente de Admin API se
# instancia en cada request, así que sin esta variable el sitio entero tira 500
# en local. Poné un placeholder si no tenés el token real.
ADMIN_API_ACCESS_TOKEN=placeholder

# --- Sesión -----------------------------------------------------------------
# Cualquier cadena larga y aleatoria. El worker no arranca sin esto.
SESSION_SECRET=cambiame-por-algo-aleatorio

# --- Opcionales -------------------------------------------------------------
# Sin esto no se carga Google Tag Manager. Dejalo vacío si la tienda todavía no
# definió a qué cuenta manda su medición.
PUBLIC_GTM_ID=
